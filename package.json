{
  "name": "dynamicchat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "node server/dynamicchat-server.mjs",
    "dev": "node server/dev-runner.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "eval:simulation": "node server/simulation-quality-eval.mjs",
    "eval:image-prompts": "node server/image-prompt-quality-eval.mjs",
    "eval:simulation-runs": "node server/simulation-run-quality-eval.mjs",
    "eval:theme-contrast": "node server/theme-contrast-eval.mjs",
    "eval:quality": "npm run eval:simulation && npm run eval:image-prompts && npm run eval:simulation-runs && npm run eval:theme-contrast && npm run eval:photoreal-suite && npm run eval:oss-models",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "eval:oss-models": "node server/oss-model-integration-eval.mjs",
    "eval:oss-suitability": "node server/oss-model-suitability-eval.mjs",
    "eval:oss-compare": "node server/oss-model-compare-eval.mjs",
    "eval:photoreal-routing": "node server/photoreal-routing-eval.mjs",
    "eval:photoreal-prompt": "node server/photoreal-prompt-eval.mjs",
    "eval:photoreal-persistence": "node server/photoreal-persistence-eval.mjs",
    "eval:photoreal-client": "node server/photoreal-client-eval.mjs",
    "eval:comfyui-relay": "node server/comfyui-relay-eval.mjs",
    "eval:local-services": "node server/local-services-eval.mjs",
    "eval:photoreal-suite": "npm run eval:photoreal-routing && npm run eval:photoreal-prompt && npm run eval:photoreal-persistence && npm run eval:photoreal-client && npm run eval:comfyui-relay && npm run eval:photoreal && npm run eval:profile-objects && npm run eval:gpu-coordinator && npm run eval:photoreal-safety && npm run eval:local-services",
    "eval:photoreal-safety": "node server/photoreal-safety-corpus-eval.mjs",
    "eval:photoreal": "node server/photoreal-pipeline-eval.mjs",
    "eval:profile-objects": "node server/profile-objects-eval.mjs",
    "eval:gpu-coordinator": "node server/photoreal-gpu-coordinator-eval.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "fflate": "^0.8.2",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3"
  }
}
